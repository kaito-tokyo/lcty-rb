root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[REUSE.toml]
indent_style = tab
indent_size = tab
tab_width = 8

[*.json]
indent_style = tab
indent_size = tab
tab_width = 2

[*.{mjs,js}]
indent_style = tab
indent_size = tab
tab_width = 2

[*.wat]
indent_style = space
tab_width = 2
